# ReelShort API Configuration
# Documentation: https://reelshort.vercel.app/

# API Base URL (Public ReelShort API - No authentication required)
API_URL=https://reelshort.vercel.app

# Note: AUTH_TOKEN is no longer required for ReelShort API
# The public API endpoints are freely accessible

# Available Endpoints:
# - GET /api/foryou?lang={lang} - Feed for you by language
# - GET /api/latest?lang={lang} - Latest feed by language  
# - GET /api/trending?lang={lang} - Trending feed by language
# - GET /search?keyword={keyword} - Search books by keyword
# - GET /api/details?book_id={book_id} - Get book details
# - GET /api/chapters/details?book_id={book_id} - Get chapters for a book
# - GET /api/stream/all-episode?book_id={book_id}&chapter_index={index} - Get episode streams

# Supported Languages: en, ja, ko, th, vi, in, zh
# Default language: en

# Response Structure:
# {
#   "ok": boolean,
#   "items": [
#     {
#       "book_id": "string",
#       "title": "string",
#       "pic": "string (image URL)",
#       "chapter_count": number,
#       "collect_count": number,
#       "theme": ["string", "string"]
#     }
#   ]
# }
